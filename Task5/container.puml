@startuml

title Диаграмма контейнера Заявка на кредит онлайн
!include ../C4/C4_Container.puml

AddContainerTag("mvp", $bgColor="#4CAF50", $borderColor="Black", $fontColor="Black")
AddContainerTag("credit", $bgColor="#FF9800", $borderColor="Black", $fontColor="Black")

Person(client, "Клиент банка", "")

System_Ext(bki, "Бюро кредитных операций")
System_Ext(sms_gateway, "СМС-Шлюз")
System_Boundary(standart, "Информационная система банка 'Стандрат'"){
    
    System_Boundary(to_be, "Новые контейнеры в рамках MVP"){
        Container(internet_bank, "Интернет-банк", "SPA React.js", "Новый интернет-банк", $tags="mvp")
        Container(api_gateway, "API Gateway", ".NET, Ocelot", $tags="mvp")
        Container(deposit_service, "Сервис по обработке депозитов", ".NET", "Обработка депозитов", $tags="mvp")
        ContainerDb(deposit_db, "БД депозиты", "PostgresSQL", $tags="mvp")
        Container(rate_service, "Сервис управления ставками", "Java Spring Boot", "", $tags="mvp")
        ContainerDb(rate_db, "БД ставки", "PostgresSQL", $tags="mvp")
        Container(adapter, "Adapter Service", "Java Spring Boot", $tags="mvp")
        ContainerQueue(kafka, "Брокер сообщений", "Kafka", $tags="mvp")
    }

    Rel_R(deposit_service, deposit_db, "", "")
    

    System_Boundary(as_is, "As-Is "){
        Container(abc_desktop, "АБС", "Delphi", "Десктоп приложение")
        ContainerDb(abc_db, "БД АБС", "Oracle")
        Container(credit_pipeline, "Кредитный конвейер", "Camunda BPM", "Система для обработки заявок на кредит. В ней сотрудники управления кредитования обрабатывают заявки от менеджеров в отделении. Это коробочное решение ")
        ContainerDb(credit_pipeline_db, "БД Кредитных заявок", "Oracle")
        Container(credit_scoring, "Система кредитного скоринга", "Python Flask", "Система определяет рейтинг клиента для выдачи ему кредита. Система использует внутренний сервис машинного обучения, где на основании модели и полученных данных выдается итоговый скоринг")
        ContainerDb(credit_scoring_db, "БД cистемы кредитного скоринга", "PostgreSQL")    
    }

    System_Boundary(to_be_credit, "Новая система для кредитных операций"){
        Container(credit_service, "Сервис формирования заявок на кредит", "Java Spring Boot", $tags="credit")
        ContainerDb(credit_db, "Заявки на кредит", "PostgresSQL",$tags="credit")
        
        Container(scoring_service, "Сервис кредитного скоринга", "Java Spring Boot", $tags="credit")
        ContainerDb(scoring_db, "", "PostgresSQL",$tags="credit")
        Container(notification, "Сервис уведомлений", "Java Spring Boot", $tags=credit)
    }

    Rel(client, internet_bank, "", "")
    
    Rel(internet_bank, api_gateway, "", "REST API")
    Rel(api_gateway, deposit_service, "Формироване заявок на депозит", "Rest API")
    
    BiRel(deposit_service, kafka, "", "pub/sub")


    Rel(rate_service, rate_db, "", "")
    Rel(api_gateway, rate_service, "", "Rest API")
    BiRel(rate_service, kafka, "", "pub/sub")
    
    BiRel(adapter, kafka, "", "pub/sub")
    BiRel(adapter, abc_db, "", "SQL")

    Rel(abc_desktop, abc_db, "PL-SQL", "")
    Rel(credit_pipeline, credit_pipeline_db, "", "")
    Rel(credit_scoring, credit_scoring_db, "", "")

    Rel(credit_pipeline, abc_db, "", "")
    Rel(credit_scoring, abc_db, "", "")

    'Работа с кредитами
    Rel(credit_service, credit_db, "", "")
    Rel(api_gateway, credit_service, "", "REST API")
    BiRel(credit_service, kafka, "", "pub/sub")

    Rel(api_gateway, scoring_service, "", "REST API")
    Rel(scoring_service, scoring_db, "", "")
    BiRel(scoring_service, kafka, "", "pub/sub")
    Rel(scoring_service, bki, "", "")


    BiRel(notification, kafka, "", "pub/sub")
    Rel(notification, sms_gateway, "", "")
}



Rel_U(credit_scoring, bki, "REST API")
Rel(sms_gateway, client, "", "СМС уведомления")



@enduml