          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yDE6W-J4p-_6eiSAyE51-30" value="Заводит обращение по депозиту" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=20;" parent="yDE6W-J4p-_6eiSAyE51-29" vertex="1" connectable="0">
          <mxGeometry x="-0.1442" y="6" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wDM25QugNmm9WNj0GW8J-1" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;Система кол-центра&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;В&lt;/font&gt;&lt;/i&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;i&gt;еб-интерфейс на React.js, бэкенд на Java Spring Boot и базы PostgreSQL. Архитектура микросервисная.&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Система развёрнута в инфраструктуре банка и полностью поддерживается подрядчиком&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
